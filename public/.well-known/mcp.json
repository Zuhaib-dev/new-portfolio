{
  "name": "zuhaibrashid-portfolio",
  "displayName": "Zuhaib Rashid Portfolio & Developer Tools",
  "description": "Official Model Context Protocol (MCP) server manifest for Zuhaib Rashid's portfolio and developer tools",
  "icon": "https://www.zuhaibrashid.com/favicon.svg",
  "iconUrl": "https://www.zuhaibrashid.com/favicon.svg",
  "version": "1.0.0",
  "protocolVersion": "2024-11-05",
  "serverUrl": "https://www.zuhaibrashid.com/api/mcp",
  "mcpUrl": "https://www.zuhaibrashid.com/api/mcp",
  "url": "https://www.zuhaibrashid.com/api/mcp",
  "instructions": "This MCP server provides tools to query portfolio metrics, live GitHub statistics, project architectures, and engineering articles for Zuhaib Rashid.",
  "capabilities": {
    "tools": {
      "listChanged": false
    },
    "resources": {
      "subscribe": false,
      "listChanged": false
    }
  },
  "tools": [
    {
      "name": "get_github_stats",
      "description": "Fetch real-time aggregated GitHub statistics (stars, forks, repositories count) for Zuhaib Rashid",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "description": "Pagination cursor token"
          },
          "limit": {
            "type": "integer",
            "description": "Number of repositories to process",
            "default": 100,
            "maximum": 100
          }
        }
      },
      "url": "https://www.zuhaibrashid.com/api/mcp"
    },
    {
      "name": "get_projects",
      "description": "Fetch portfolio showcase projects including HealOS, Rydexx, DealDrop, Repoviz, and Resumind with architecture tech stacks",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "Optional project filter"
          }
        }
      },
      "url": "https://www.zuhaibrashid.com/api/mcp"
    },
    {
      "name": "get_blog_posts",
      "description": "Retrieve list of published technical articles on Next.js security, AI agent web development, and performance optimization",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "Max articles to return",
            "default": 10
          }
        }
      },
      "url": "https://www.zuhaibrashid.com/api/mcp"
    }
  ],
  "resources": [
    {
      "uri": "https://www.zuhaibrashid.com/llms.txt",
      "name": "Site Manifest",
      "mimeType": "text/markdown",
      "description": "Structured Markdown overview of the portfolio"
    },
    {
      "uri": "https://www.zuhaibrashid.com/openapi.json",
      "name": "OpenAPI Spec",
      "mimeType": "application/json",
      "description": "Complete REST API specification"
    },
    {
      "uri": "https://www.zuhaibrashid.com/agents.md",
      "name": "Agent Guide",
      "mimeType": "text/markdown",
      "description": "Operational instructions for AI agents"
    }
  ]
}
